<?xml version="1.0"?>
<launch>

  <!-- === Hardware namespace === -->
  <arg name="namespace"
       default="hardware"
       description="Top-level namespace for all hardware nodes"/>

  <!-- tf_prefix -->
  <arg name="tf_prefix"
       default="$(var namespace)/"
       description="TF prefix for all hardware frames"/>

  <!-- === Robotino Arguments === -->
  <arg name="use_sim_time"
       default="false"   
       description="Use simulation time (/clock)"/>

  <arg name="launch_jsb"
       default="false"
       description="Launch joint_state_publisher"/>

  <arg name="hostname"
       default="127.0.1.1"
       description="Robotino hostname or IP address"/>

  <arg name="rsp_freq"
       default="20.0"
       description="Update rate for robot_state_publisher"/>

  <arg name="bumper_timeout"
       default="0.0"
       description="Time before bumper stop triggers"/>

  <arg name="motor_timeout"
       default="0.0"
       description="Motor timeout setting"/>

  <arg name="launch_odom_tf"
       default="true"
       description="Publish odom TF frame"/>

  <!-- Robot description -->
  <arg name="robot_description"
       default="$(find-pkg-share justina_description)/urdf/justina.urdf"
       description="Path to Robotino .urdf file"/>

  <group>
    <push-ros-namespace namespace="$(var namespace)"/>
     <set_remap from="/$(var namespace)/base/joint_states"  to="/$(var namespace)/joint_states"/>

     <!-- Base driver launch -->
     <include file="$(find-pkg-share base)/launch/base_driver.launch.xml">
          <arg name="namespace"         value="base"/>
          <arg name="tf_prefix"         value=""/>
          <arg name="use_sim_time"      value="$(var use_sim_time)"/>
          <arg name="launch_jsb"        value="$(var launch_jsb)"/>
          <arg name="robot_description" value="$(var robot_description)"/>
          <arg name="hostname"          value="$(var hostname)"/>
          <arg name="rsp_freq"          value="$(var rsp_freq)"/>
          <arg name="bumper_timeout"    value="$(var bumper_timeout)"/>
          <arg name="motor_timeout"     value="$(var motor_timeout)"/>
          <arg name="launch_odom_tf"    value="$(var launch_odom_tf)"/>
     </include>
  </group>

  <group>
    <push-ros-namespace namespace="$(var namespace)"/>
          <set_remap from="/$(var namespace)/head/joint_states"  to="/$(var namespace)/joint_states"/>
          <set_remap from="/$(var namespace)/arms/left_arm/joint_states"  to="/$(var namespace)/joint_states"/>
          <set_remap from="/$(var namespace)/arms/right_arm/joint_states" to="/$(var namespace)/joint_states"/>
          <set_remap from="/$(var namespace)/torso/joint_states" to="/$(var namespace)/joint_states"/>
          
          <!-- Head -->
          <include file="$(find-pkg-share head)/launch/head.launch.xml"/>
          
          <!-- Right Arm -->
          <include file="$(find-pkg-share arms)/launch/arms.launch.xml"/>
          
          <!-- Torso -->
          <include file="$(find-pkg-share torso)/launch/torso.launch.xml"/>

          <!-- Grippers -->
          <!-- include file="$(find-pkg-share grippers)/launch/grippers.launch.xml"/ -->

          <!-- Joint States Parser -->
          <include file="$(find-pkg-share joint_states_parser)/launch/joint_states_parser.launch.xml"/>

          <!-- Gui -->
          <node pkg="hsrb_gui" 
               exec="gui_node" 
               name="gui_node" 
               output="screen"/>
  </group>

  <!-- Robot State Publisher -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" namespace="hardware">
    <remap from="joint_states" to="/manipulation/joint_states"/>
    <param name="robot_description" value="$(command 'cat $(var robot_description)')" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
    <param name="publish_frequency" value="$(var rsp_freq)" />
  </node>

</launch>
